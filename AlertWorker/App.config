<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- same connection string used by Web app -->
    <add name="RCTempConnection" connectionString="Data Source=OIT-L-BY10S73\SQLEXPRESS2019;Initial Catalog=RCTemp;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>


<appSettings>
  <!-- Base URL used to build JobDetails links in emails -->
  <add key="SiteBaseUrl" value="https://www.yoursite.com" />

  <!-- SMTP settings -->
  <add key="SmtpHost" value="smtp.example.com" />
  <add key="SmtpPort" value="587" />
  <add key="SmtpEnableSsl" value="true" />
  <add key="SmtpUser" value="smtp_user@example.com" />
  <add key="SmtpPass" value="smtp_password" />
  <add key="EmailFrom" value="no-reply@example.com" />
</appSettings>

</configuration>